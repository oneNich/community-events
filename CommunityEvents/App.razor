<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Community Events</title>
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="CommunityEvents.styles.css" />
</head>
<body>
    <div id="app">
        <svg style="margin-left: 40.0%; margin-top: 20.0%; width: 15.0%; aspect-ratio: 1 / 1;" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
            <style>
                @keyframes lds-ring { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
                .lds-ring { animation: lds-ring 1.5s cubic-bezier(0.5, 0, 0.5, 1) infinite; transform-origin: 50px 50px; }
                .lds-ring div { box-sizing: border-box; display: block; position: absolute; width: 80px; height: 80px; margin: 10px; border: 8px solid #512bd4; border-radius: 50%; animation: lds-ring-child 1.2s cubic-bezier(0.5, 0, 0.5, 1) infinite; }
                .lds-ring div:nth-child(1) { animation-delay: -0.45s; }
                .lds-ring div:nth-child(2) { animation-delay: -0.3s; }
                .lds-ring div:nth-child(3) { animation-delay: -0.15s; }
                @keyframes lds-ring-child { 0% { transform: scale(1); } 100% { transform: scale(0); } }
            </style>
            <g class="lds-ring">
                <div></div>
                <div></div>
                <div></div>
                <div></div>
            </g>
        </svg>
    </div>

    <script src="_framework/blazor.web.js"></script>
</body>
</html>
